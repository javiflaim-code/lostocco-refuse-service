# Contact / start-service form endpoint.
# Swap this for your own Formspree form ID (https://formspree.io) or any
# endpoint that accepts a JSON POST and returns 2xx on success.
# Leave it unset in development and the form runs in demo mode: it validates,
# shows the loading and success states, but does not send anything.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Absolute site URL, used for canonical links, Open Graph and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://lostocco-refuse-service.vercel.app
